            101.2,
            314.19,
            542.01,
            328.58
          ],
          "noi_dung": "- Xóa các lớp học phần có sĩ số đăng ký không đủ điều kiện mở lớp (danh sách đính kèm)."
        },
        {
          "loai": "van_ban",
          "dang": "bullet",
          "bbox": [
            65.2,
            335.14,
            544.25,
            379.43
          ],
          "noi_dung": "- Sinh viên đã đăng ký vào các lớp học phần thông báo xóa cần chuyển kế hoạch học tập sang học kỳ tiếp theo hoặc đăng ký vào các lớp học phần còn lại hoặc đăng ký học phần khác thay thế trong đợt 2 từ ngày 12/05/2025 đến 18/05/2025."
        },
        {
          "loai": "van_ban",
          "dang": "doan_van",
          "bbox": [
            65.2,
            385.98,
            544.24,
            415.32
          ],
          "noi_dung": "Đề nghị lãnh đạo các đơn vị phổ biến nội dung công văn này đến toàn thể giảng viên, cố vấn học tập và sinh viên biết để triển khai thực hiện đúng quy định."
        }
      ]
